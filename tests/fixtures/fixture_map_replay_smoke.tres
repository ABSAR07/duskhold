enemies = Array[ExtResource("8_enemy")]([SubResource("Resource_grunt"), SubResource("Resource_skirmisher")])
spawn_points = Array[ExtResource("5_spawn")]([SubResource("Resource_spawn_west"), SubResource("Resource_spawn_north")])
nights = Array[ExtResource("7_night")]([SubResource("Resource_night_1"), SubResource("Resource_night_2")])
castle_max_health = 20
castle_radius = 3.5
