[gd_resource type="Resource" script_class="MapConfig" load_steps=21 format=3]

[ext_resource type="Script" path="res://simulation/defs/map_config.gd" id="1_map"]
[ext_resource type="Script" path="res://simulation/defs/build_spot_def.gd" id="2_spot"]
[ext_resource type="Script" path="res://simulation/defs/building_def.gd" id="3_bdef"]
[ext_resource type="Script" path="res://simulation/defs/spawn_point_def.gd" id="4_spawn"]
[ext_resource type="Script" path="res://simulation/defs/spawn_group_def.gd" id="5_group"]
[ext_resource type="Script" path="res://simulation/defs/night_def.gd" id="6_night"]
[ext_resource type="Script" path="res://simulation/defs/enemy_def.gd" id="7_enemy"]
[ext_resource type="Script" path="res://simulation/defs/unit_def.gd" id="8_unit"]
[ext_resource type="Resource" path="res://data/buildings/house.tres" id="9_house"]
[ext_resource type="Resource" path="res://data/buildings/tower.tres" id="10_tower"]
[ext_resource type="Resource" path="res://data/buildings/barracks.tres" id="11_barracks"]
[ext_resource type="Resource" path="res://data/enemies/grunt.tres" id="12_grunt"]
[ext_resource type="Resource" path="res://data/units/footman.tres" id="13_footman"]

[sub_resource type="Resource" id="Resource_house_1"]
script = ExtResource("2_spot")
id = &"house_1"
position = Vector3(-9, 0, 9)
building_id = &"house"

[sub_resource type="Resource" id="Resource_barracks_1"]
script = ExtResource("2_spot")
id = &"barracks_1"
position = Vector3(-10, 0, -4)
building_id = &"barracks"

[sub_resource type="Resource" id="Resource_west"]
script = ExtResource("4_spawn")
id = &"west"
display_name = "West"
position = Vector3(-30, 0, 0)
scatter_radius = 2.0

[sub_resource type="Resource" id="Resource_group_1"]
script = ExtResource("5_group")
spawn_point_id = &"west"
enemy_id = &"grunt"
count = 4
start_delay_seconds = 0.5
interval_seconds = 1.0

[sub_resource type="Resource" id="Resource_group_2"]
script = ExtResource("5_group")
spawn_point_id = &"west"
enemy_id = &"grunt"
count = 5
start_delay_seconds = 0.5
interval_seconds = 1.0

[sub_resource type="Resource" id="Resource_night_1"]
script = ExtResource("6_night")
groups = Array[ExtResource("5_group")]([SubResource("Resource_group_1")])

[sub_resource type="Resource" id="Resource_night_2"]
script = ExtResource("6_night")
groups = Array[ExtResource("5_group")]([SubResource("Resource_group_2")])

[resource]
script = ExtResource("1_map")
id = &"fixture_squads"
display_name = "Fixture Squads"
is_sandbox = true
starting_gold = 40
king_spawn = Vector3(0, 0, 7)
castle_position = Vector3(0, 0, 0)
buildings = Array[ExtResource("3_bdef")]([ExtResource("9_house"), ExtResource("10_tower"), ExtResource("11_barracks")])
spots = Array[ExtResource("2_spot")]([SubResource("Resource_house_1"), SubResource("Resource_barracks_1")])
enemies = Array[ExtResource("7_enemy")]([ExtResource("12_grunt")])
units = Array[ExtResource("8_unit")]([ExtResource("13_footman")])
spawn_points = Array[ExtResource("4_spawn")]([SubResource("Resource_west")])
nights = Array[ExtResource("6_night")]([SubResource("Resource_night_1"), SubResource("Resource_night_2")])
castle_max_health = 40
castle_radius = 3.5
