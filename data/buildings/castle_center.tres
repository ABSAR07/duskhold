attack_damage = 3
max_health = 100
attack_interval = 1.5
projectile_speed = 27.0
choices = Array[ExtResource("3_choice")]([ExtResource("4_royal"), ExtResource("5_commander"), ExtResource("6_masons"), ExtResource("7_prosperity")])

[sub_resource type="Resource" id="Resource_tier3"]
