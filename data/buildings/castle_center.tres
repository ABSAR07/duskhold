[resource]
script = ExtResource("2_def")
id = &"castle_center"
display_name = "Castle"
body_radius = 3.5
tiers = Array[ExtResource("1_tier")]([SubResource("Resource_tier1"), SubResource("Resource_tier2"), SubResource("Resource_tier3"), SubResource("Resource_tier4")])
