[gd_resource type="Resource" script_class="ChoiceDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://simulation/defs/choice_def.gd" id="1_choice"]
[ext_resource type="Script" path="res://simulation/stats/stat_modifier_def.gd" id="2_mod"]
[ext_resource type="Texture2D" path="res://assets/first_party/card_icons/warded_mail.svg" id="3_icon"]

[sub_resource type="Resource" id="Resource_taken"]
