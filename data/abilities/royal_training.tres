[gd_resource type="Resource" script_class="ChoiceDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://simulation/defs/choice_def.gd" id="1_choice"]
[ext_resource type="Script" path="res://simulation/stats/stat_modifier_def.gd" id="2_mod"]
[ext_resource type="Texture2D" path="res://assets/first_party/card_icons/royal_training.svg" id="3_icon"]

[sub_resource type="Resource" id="Resource_health"]
script = ExtResource("2_mod")
stat = &"king.max_health"
bucket = 1
value = 25

[sub_resource type="Resource" id="Resource_damage"]
script = ExtResource("2_mod")
stat = &"king.attack_damage"
value = 100

[resource]
script = ExtResource("1_choice")
id = &"royal_training"
display_name = "Royal Training"
flavour = "The king drills until the blade feels light."
icon = ExtResource("3_icon")
modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_health"), SubResource("Resource_damage")])
