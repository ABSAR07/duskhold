[gd_resource type="Resource" script_class="ChoiceDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://simulation/defs/choice_def.gd" id="1_choice"]
[ext_resource type="Script" path="res://simulation/stats/stat_modifier_def.gd" id="2_mod"]
[ext_resource type="Texture2D" path="res://assets/first_party/card_icons/headsmans_edge.svg" id="3_icon"]

[sub_resource type="Resource" id="Resource_damage"]
script = ExtResource("2_mod")
stat = &"king.attack_damage"
bucket = 2
value = 200

[sub_resource type="Resource" id="Resource_interval"]
script = ExtResource("2_mod")
stat = &"king.attack_interval"
bucket = 2
value = 150

[resource]
script = ExtResource("1_choice")
id = &"headsmans_edge"
display_name = "Headsman's Edge"
flavour = "One heavy cut in place of two light ones."
icon = ExtResource("3_icon")
modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_damage"), SubResource("Resource_interval")])
